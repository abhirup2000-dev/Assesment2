<style>
  body {
    margin: 0;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
  }

  .container {
    padding: 40px 60px;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
  }

  .title {
    color: white;
    font-size: 30px;
    font-weight: 600;
  }

  .create-btn {
    background: linear-gradient(135deg, #00c9a7, #00b4d8);
    padding: 10px 18px;
    border-radius: 12px;
    color: white;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
  }

  .create-btn:hover {
    transform: translateY(-2px) scale(1.05);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
  }

  .card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(15px);
    border-radius: 18px;
    overflow: hidden;
    color: white;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    transition: 0.3s;
  }

  .card:hover {
    transform: translateY(-8px);
  }

  .card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
  }

  .card-body {
    padding: 15px;
  }

  .card-body h3 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .category {
    font-size: 11px;
    background: rgba(255,255,255,0.25);
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .desc {
    font-size: 13px;
    opacity: 0.85;
    height: 40px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .btn {
    flex: 1;
    padding: 7px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    text-align: center;
    transition: 0.25s;
  }

  .edit {
    background: #00c9a7;
    color: white;
  }

  .delete {
    background: #ff4d4d;
    color: white;
  }

  .btn:hover {
    transform: scale(1.05);
  }

  .empty {
    text-align: center;
    color: white;
    margin-top: 70px;
  }

  .empty h3 {
    margin-bottom: 5px;
  }

  .empty p {
    opacity: 0.8;
  }

  .actions {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.action-form {
  flex: 1;
}

.btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 8px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
}

.edit {
  background: linear-gradient(135deg, #00c9a7, #00e0b8);
  color: white;
}

.delete {
  background: linear-gradient(135deg, #ff4d4d, #ff6b6b);
  color: white;
}

.btn:hover {
  transform: scale(1.05);
}

.view-btn {
  display: inline-block;
  margin-top: 10px;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 13px;
  text-decoration: none;
  color: white;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  transition: all 0.3s ease;
  box-shadow: 0 6px 15px rgba(0,0,0,0.25);
}

.view-btn:hover {
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 10px 20px rgba(0,0,0,0.35);
}
</style>

<div class="container">

  <div class="top-bar">
    <h1 class="title">Product Dashboard</h1>
    <a href="/product/create-view" class="create-btn">+ Create</a>
  </div>

  <div class="grid">
    <% if (products.length > 0) { %>
      <% products.forEach(product => { %>
        <% if(product.isDeleted == false){ %>

        <div class="card">

          <img 
            src="<%= product?.image ? '/' + product.image : '/images/no-image.png' %>" 
            alt="product">

          <div class="card-body">
            <h3><%= product.name %></h3>

            <span class="category"><%= product.category %></span>

            <p class="desc"><%= product.description %></p>

            <a href="#" class="view-btn">View Details</a>

          </div>
        </div>

        <% } %>
      <% }) %>
    <% } else { %>
      <div class="empty">
        <h3>No products found</h3>
        <p>Create your first product</p>
      </div>
    <% } %>
  </div>

</div>