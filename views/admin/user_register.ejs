
<style>
  body {
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
  }

  .container {
    padding: 40px;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .title {
    color: white;
    font-size: 28px;
    font-weight: 600;
  }

  .create-btn {
    background: linear-gradient(135deg, #00c9a7, #00b4d8);
    padding: 10px 18px;
    border-radius: 10px;
    color: white;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
  }

  .create-btn:hover {
    transform: scale(1.05);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
  }

  .card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    border-radius: 20px;
    overflow: hidden;
    color: white;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    transition: all 0.3s ease;
    position: relative;
  }

  .card:hover {
    transform: translateY(-8px) scale(1.02);
  }

  .card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
  }

  .card-body {
    padding: 15px;
  }

  .card h3 {
    margin-bottom: 5px;
    font-size: 18px;
  }

  .category {
    font-size: 12px;
    background: rgba(255,255,255,0.2);
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .desc {
    font-size: 13px;
    opacity: 0.85;
    height: 40px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
  }

  .btn {
    flex: 1;
    padding: 7px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    transition: 0.2s;
  }

  .btn + .btn {
    margin-left: 8px;
  }

  .edit {
    background: #00c9a7;
    color: white;
  }

  .delete {
    background: #ff4d4d;
    color: white;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .empty {
    text-align: center;
    color: white;
    margin-top: 50px;
    opacity: 0.8;
  }
</style>

<div class="container">

  <div class="top-bar">
    <h1 class="title"> Product Dashboard</h1>
    <a href="/product/create-view" class="create-btn">+ Create Product</a>
  </div>

  <div class="grid">
    <% if (products.length > 0) { %>
      <% products.forEach(product => { %>

        <div class="card">
          
          <% if(product.image) { %>
            <!-- <img src="/<%= product.image %>" alt="product"> -->
             <img src="<%= product.image ? '/' + product.image : '/images/no-image.png' %>" alt="product">
          <% } %>

          <div class="card-body">
            <h3><%= product.name %></h3>

            <span class="category"><%= product.category %></span>

            <p class="desc"><%= product.description %></p>

            <div class="actions">
              <a href="/product/edit/<%= product._id %>" class="btn edit">Edit</a>

              <form action="/product/delete/<%= product._id %>" method="POST">
                <button class="btn delete"
                  onclick="return confirm('Delete this product?')">
                  Delete
                </button>
              </form>
            </div>
          </div>

        </div>

      <% }) %>
    <% } else { %>
      <div class="empty">
        <h3>No products found</h3>
        <p>Start by creating your first product</p>
      </div>
    <% } %>
  </div>

</div>